# zkopírujte na .env a vyplňte (.env necommitovat!)
SECRET_KEY=zmente-na-dlouhy-nahodny-retezec
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,NAZEV-NEBO-IP-FIREMNIHO-PC
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://NAZEV-NEBO-IP-FIREMNIHO-PC:8080
DB_NAME=businessmanager
DB_USER=businessmanager
DB_PASSWORD=zmente-heslo
# HTTPS=1 jen když aplikace běží za HTTPS (Caddy, nginx); cookies se pak posílají jen šifrovaně
HTTPS=0
# Limit nahrávaných souborů v MB: jeden soubor / celé nahrání najednou (např. víc fotek)
MAX_VELIKOST_SOUBORU_MB=50
MAX_VELIKOST_NAHRAVANI_MB=500
# Záloha (zaloha.bat): kam kopírovat poslední zálohu (jiný disk nebo PC, drží se 2 poslední), např. E:\Zalohy nebo \\JINE-PC\Zalohy
ZALOHA_KOPIE=
# kolik záloh nechat ve složce zalohy na tomto PC
ZALOHA_PONECHAT=7
